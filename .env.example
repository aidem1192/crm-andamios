# Copia este archivo como .env para desarrollo local, o define estas mismas
# variables directamente en el panel de Railway (Settings → Variables) para producción.

# Cadena de conexión de Supabase (Project Settings → Database → Connection string).
# Usa el modo "Transaction pooler" (puerto 6543) si el hosting corre en modo serverless/varias réplicas.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Clave para firmar las cookies de sesión. Genera una única y distinta a la de este repo, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-unica-y-secreta

# Pon "true" en producción (Railway sirve HTTPS) para que las cookies de sesión solo viajen por HTTPS.
HTTPS_ONLY=true

# PIN para autorizar descuentos en contratos. Cambia el valor por defecto (1234).
PIN_DESCUENTO=1234
